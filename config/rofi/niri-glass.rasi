configuration {
    terminal: "alacritty";
    show-icons: true;
    icon-theme: "breeze";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec";
    disable-history: true;
    entry {
        max-history: 0;
    }
}

* {
    background-color: transparent;
    text-color: #e7ebf7;
    accent: #c4b5fd;
    font: "Noto Sans, Noto Sans CJK SC 12";
}

window {
    location: north;
    anchor: north;
    y-offset: 24%;
    width: 560px;
    background-color: #161a2988;
    border: 1px;
    border-color: #b9c6ec63;
    border-radius: 22px;
}

mainbox {
    children: [inputbar, listview];
    padding: 10px;
    spacing: 0;
}

inputbar {
    children: [textbox-prefix, entry];
    padding: 10px 14px;
    spacing: 13px;
}

textbox-prefix {
    str: ">";
    font: "JetBrains Mono Medium 15";
    text-color: @accent;
    expand: false;
    vertical-align: 0.5;
}

entry {
    font: "Noto Sans, Noto Sans CJK SC 15";
    placeholder: "";
    cursor-color: @accent;
}

listview {
    lines: 6;
    require-input: true;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 3px;
}

element {
    children: [element-icon, element-text];
    padding: 8px 14px;
    spacing: 12px;
    border-radius: 12px;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold #c4b5fd;
}

element selected {
    background-color: #c4b5fd39;
    text-color: #f5f0ff;
}
